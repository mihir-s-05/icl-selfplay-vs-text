+"""Data-location constants used by the bake scripts.
+
+This module is imported by ``src.scripts.constants`` but was not part of the
+public release; this shim restores it. ``TEST_DATA_DIR`` is where
+``prepare_*_benchmark`` scripts write context-stamped bakes
+(``<TEST_DATA_DIR>/c<context>/<stem>.jsonl``) and cache raw sources.
+"""
+from pathlib import Path
+
+_SCORING_ROOT = Path(__file__).resolve().parents[2]
+
+TEST_DATA_DIR = _SCORING_ROOT / "data"
+SWEEP_GLOB = "sweep_*"
+SWEEP_SEED_GLOB = "sweep_*/seed-*"
